[Unit]
Description=USB gadget (NCM ethernet + ACM serial)
After=sys-kernel-config.mount systemd-modules-load.service
Requires=sys-kernel-config.mount
Before=network-pre.target
Wants=network-pre.target

# No RemainAfterExit: udev (90-edison-gadget.rules) starts this again whenever a USB
# device controller appears, so the gadget gets (re)bound.
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/edison-gadget

[Install]
WantedBy=multi-user.target
