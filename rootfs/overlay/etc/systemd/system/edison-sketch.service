# Runs the Arduino sketch uploaded by arduino-core-edison's uploader. The sketch opens
# /dev/ttyGS0 (the USB serial port) itself as Serial.
[Unit]
Description=Arduino sketch
After=edison-acpi-tables.service edison-gadget.service edison-serial-hold.service
ConditionPathExists=/var/lib/edison-sketch/sketch.elf

[Service]
User=edison
WorkingDirectory=/var/lib/edison-sketch
ExecStart=/var/lib/edison-sketch/sketch.elf
Restart=on-failure
RestartSec=2
# Sketches built with arduino-core-edison stop within milliseconds of SIGTERM, wherever
# they are, returning their pins to inputs. Kill anything still running after this rather
# than holding up a new upload for systemd's default 90 s.
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
