# U-Boot environment for fw_printenv/fw_setenv: two redundant 64 KiB copies at the start
# of the u-boot-env0/1 partitions (CONFIG_ENV_OFFSET 0x300000 / 0x600000 on the eMMC).
# See uboot/env.txt in edison-image.
# Device                               Offset  Size
/dev/disk/by-partlabel/u-boot-env0     0x0000  0x10000
/dev/disk/by-partlabel/u-boot-env1     0x0000  0x10000
