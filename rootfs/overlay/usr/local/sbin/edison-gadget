#!/bin/sh
# Set up the USB device-mode gadget: NCM ethernet (usb0) + ACM serial (ttyGS0), and bind
# it to the USB device controller. NCM is supported natively by Linux, macOS and
# Windows 10/11.
#
# Safe to run repeatedly. It runs at boot and again from udev whenever a device controller
# (UDC) appears, because the dwc3 UDC can register after this first runs; writing an
# empty name to UDC "succeeds" without binding anything.
set -eu

G=/sys/kernel/config/usb_gadget/edison

bind() {
    udc=
    for u in /sys/class/udc/*; do
        [ -e "$u" ] && { udc=$(basename "$u"); break; }
    done
    if [ -z "$udc" ]; then
        echo "no USB device controller yet; udev will run this again when one appears"
        exit 0
    fi
    if [ -n "$(cat "$G/UDC")" ]; then
        exit 0
    fi
    echo "$udc" > "$G/UDC"
    echo "bound to $udc"
}

if [ -d "$G/configs/c.1/ncm.usb0" ]; then
    bind
    exit 0
fi

modprobe libcomposite
mkdir -p "$G"
cd "$G"

echo 0x1d6b > idVendor     # Linux Foundation
echo 0x0104 > idProduct    # Multifunction Composite Gadget
echo 0x0100 > bcdDevice
echo 0x0200 > bcdUSB
echo 0xEF > bDeviceClass   # Miscellaneous / IAD, needed for composite NCM + ACM
echo 0x02 > bDeviceSubClass
echo 0x01 > bDeviceProtocol

# Stable per-board MAC addresses and serial number (locally administered, unicast),
# derived from the factory serial number so they survive reflashing; the machine ID (new
# with every flash) is only a fallback.
if [ -s /factory/serial_number ]; then
    id_source=/factory/serial_number
else
    id_source=/etc/machine-id
fi
hash=$(md5sum "$id_source" | cut -c1-24)
mac() { echo "$1" | sed 's/\(..\)/\1:/g; s/:$//'; }
dev_addr=$(mac "02$(echo "$hash" | cut -c1-10)")
host_addr=$(mac "06$(echo "$hash" | cut -c11-20)")

mkdir -p strings/0x409
echo "$hash" > strings/0x409/serialnumber
echo "open-edison" > strings/0x409/manufacturer
echo "Intel Edison" > strings/0x409/product

mkdir -p configs/c.1/strings/0x409
echo "NCM + ACM" > configs/c.1/strings/0x409/configuration
echo 250 > configs/c.1/MaxPower

mkdir -p functions/ncm.usb0 functions/acm.usb0
echo "$dev_addr" > functions/ncm.usb0/dev_addr
echo "$host_addr" > functions/ncm.usb0/host_addr
# The serial port is for sketches, not a modem: don't declare AT commands (the default),
# or hosts' ModemManager probes it with AT commands whenever the board appears. Only
# settable before the function is linked into the configuration.
if [ -e functions/acm.usb0/protocol ]; then
    echo 0 > functions/acm.usb0/protocol
fi

ln -s functions/ncm.usb0 configs/c.1/
ln -s functions/acm.usb0 configs/c.1/

bind
