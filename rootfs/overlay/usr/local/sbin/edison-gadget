#!/bin/sh
# Set up the USB device-mode gadget: NCM ethernet (usb0) + ACM serial (ttyGS0).
# NCM is supported natively by Linux, macOS and Windows 10/11.
set -eu

G=/sys/kernel/config/usb_gadget/edison
[ -d "$G" ] && exit 0

modprobe libcomposite
mkdir -p "$G"
cd "$G"

echo 0x1d6b > idVendor     # Linux Foundation
echo 0x0104 > idProduct    # Multifunction Composite Gadget
echo 0x0100 > bcdDevice
echo 0x0200 > bcdUSB
echo 0xEF > bDeviceClass   # Miscellaneous / IAD, needed for composite NCM + ACM
echo 0x02 > bDeviceSubClass
echo 0x01 > bDeviceProtocol

# Stable per-board MAC addresses and serial number, derived from the machine ID
# (locally administered, unicast).
hash=$(md5sum /etc/machine-id | cut -c1-24)
mac() { echo "$1" | sed 's/\(..\)/\1:/g; s/:$//'; }
dev_addr=$(mac "02$(echo "$hash" | cut -c1-10)")
host_addr=$(mac "06$(echo "$hash" | cut -c11-20)")

mkdir -p strings/0x409
echo "$hash" > strings/0x409/serialnumber
echo "edison-revival" > strings/0x409/manufacturer
echo "Intel Edison" > strings/0x409/product

mkdir -p configs/c.1/strings/0x409
echo "NCM + ACM" > configs/c.1/strings/0x409/configuration
echo 250 > configs/c.1/MaxPower

mkdir -p functions/ncm.usb0 functions/acm.usb0
echo "$dev_addr" > functions/ncm.usb0/dev_addr
echo "$host_addr" > functions/ncm.usb0/host_addr

ln -s functions/ncm.usb0 configs/c.1/
ln -s functions/acm.usb0 configs/c.1/

ls /sys/class/udc | head -n1 > UDC
