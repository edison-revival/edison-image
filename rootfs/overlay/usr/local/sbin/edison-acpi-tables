#!/bin/sh
# Load the ACPI table overlays (Arduino kit description) through configfs, then pulse
# TRI_STATE_ALL so the header's level shifters come up in the configured state. Based on
# meta-acpi's acpi-tables-load (MIT).
set -eu

TABLES=/usr/lib/edison/acpi
CONFIGFS=/sys/kernel/config/acpi/table

for aml in "$TABLES"/*.aml; do
    [ -e "$aml" ] || continue
    name=$(basename "$aml" .aml)
    [ -d "$CONFIGFS/$name" ] && continue
    mkdir "$CONFIGFS/$name"
    cat "$aml" > "$CONFIGFS/$name/aml"
    echo "loaded $name"
done

# The expanders probe asynchronously; wait for the line to exist.
for _ in $(seq 50); do
    gpioinfo TRI_STATE_ALL >/dev/null 2>&1 && break
    sleep 0.1
done
if ! gpioinfo TRI_STATE_ALL >/dev/null 2>&1; then
    echo "TRI_STATE_ALL not found: the Arduino kit's GPIO expander at I2C-1 0x20 isn't" >&2
    echo "responding (see dmesg | grep pca953x). It can wedge across a reset; power-cycle" >&2
    echo "the board fully (unplug all power) to clear it." >&2
    exit 1
fi
# Header pins start as inputs, as on other Arduinos. A warm reboot doesn't reset the
# expanders, so IO13's level shifter can still be an output from before (an older image's
# heartbeat LED, or a sketch), passing on an undriven SoC line and lighting the DS2 LED.
# Make it an input and let go: the expander keeps the level, and sketches can still claim
# the line.
gpioset -t0 MUX18_DIR=0 || true
# The kit's ADC shares SPI5 with the header's SPI pins (IO10-IO13), through muxes whose
# selects the expander leaves undriven. Left floating, they connect the ADC's bus to the
# header and the ADC reads nothing (all zeros, or EIO from the driver). Route the header
# pins to their GPIOs instead. With SPI enabled on the header (MUX_SPI), the overlay holds
# these lines and this does nothing.
gpioset -t0 SPI_CLK_SEL=0 SPI_TXD_SEL=0 SPI_RXD_SEL=0 SPI_FS_SEL=0 2>/dev/null || true
# The ADC's driver sends its settings (the 0-2xREF range, so full scale is IOREF) only when
# it probes, which happened when the overlay loaded, before its bus was isolated: the
# ADC missed them and stays in its power-on range (full scale half IOREF). Probe it again.
adc=/sys/bus/spi/drivers/ads7950
for dev in "$adc"/spi-*; do
    [ -e "$dev" ] || continue
    name=$(basename "$dev")
    echo "$name" > "$adc/unbind"
    echo "$name" > "$adc/bind"
done
# libgpiod v2 only guarantees a value while gpioset holds the line: pulse it low briefly,
# then keep holding it high (the process stays in this unit's cgroup).
timeout 0.2 gpioset TRI_STATE_ALL=0 || true
gpioset -z TRI_STATE_ALL=1
